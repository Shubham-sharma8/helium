# Helium — Google OAuth 2.0 & Cloud Environment Configuration
# Copy this file to `.env` or copy `GoogleService-Info.plist.example` to `GoogleService-Info.plist`

# OAuth 2.0 Client ID (iOS / macOS type from Google Cloud Console -> APIs & Services -> Credentials)
HELIUM_GOOGLE_CLIENT_ID=YOUR_PROJECT_NUMBER-YOUR_CLIENT_HASH.apps.googleusercontent.com

# Reversed Client ID URL scheme registered in Info.plist for PKCE OAuth callback
HELIUM_REVERSED_CLIENT_ID=com.googleusercontent.apps.YOUR_PROJECT_NUMBER-YOUR_CLIENT_HASH

# Optional Google Cloud Project metadata
HELIUM_FIREBASE_PROJECT_ID=your-google-cloud-project-id
HELIUM_GOOGLE_PROJECT_NUMBER=YOUR_PROJECT_NUMBER
HELIUM_FIREBASE_API_KEY=YOUR_GOOGLE_API_KEY
